# Copy to .env and fill in your values

# API Gateway URL for the LLM Lambda functions (jrf-task-llm-*)
REACT_APP_LLM_API_URL=https://YOUR_API_GATEWAY_ID.execute-api.ap-southeast-2.amazonaws.com/prod

# API Gateway URL for the existing OCR pipeline (used to fetch document list + presigned URLs)
REACT_APP_OCR_API_URL=https://o0dqnexpsg.execute-api.ap-southeast-2.amazonaws.com/prod

# URL of the NLP Pipeline app (used for the "← NLP Pipeline" back-link in the topbar)
REACT_APP_NLP_PIPELINE_URL=https://jrf-nlp-pipeline.skillrouteai.com
